# copy to local.env and fill in; git ignores local.env
DUO_ZIP=
DUO_NTFY_TOPIC=
DUO_EMAIL_TO=
DUO_GMAIL_USER=
DUO_GMAIL_APP_PW=
# optional: your T-Mobile number, typed into the T-Mobile account check so you only enter the PIN and picture code
DUO_TMOBILE_NUMBER=
# Chrome profile signed in to your Apple Account (last part of Profile Path on chrome://version)
DUO_CHROME_PROFILE=
# safari or chrome (default); Safari lets you sign in to Apple with Touch ID
DUO_BROWSER=
# optional: someone else picks up the order (leave DUO_PICKUP_FIRST empty to pick up yourself)
DUO_PICKUP_FIRST=
DUO_PICKUP_LAST=
DUO_PICKUP_EMAIL=
DUO_PICKUP_PHONE=
# optional: part numbers kept in the Safari bag ahead of time (e.g. MK1E4LL/A,MK1G4LL/A); checkout then starts at the bag
DUO_READY_CART=
# phone 2: a second iPhone on another Apple Account (subscribe it to <DUO_NTFY_TOPIC>-p2). All optional:
# pickup person for its orders (empty = whoever owns that account) and its ready cart (empty = same as DUO_READY_CART)
DUO2_PICKUP_FIRST=
DUO2_PICKUP_LAST=
DUO2_PICKUP_EMAIL=
DUO2_PICKUP_PHONE=
DUO2_READY_CART=
# PS5 Pro on PS Direct (ps5_watch.py): its own ntfy topic; empty = DUO_NTFY_TOPIC. The phone script logs to <topic>-ps5log
PS5_NTFY_TOPIC=
